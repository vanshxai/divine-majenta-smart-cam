# secrets -- never commit camera credentials
.camera_user
.camera_pw

# sensitive/private data -- employee & visitor face photos + biometric embeddings.
# Deliberately excluded by default; see conversation about whether to include these.
events.db
snapshots/
known_faces/

# pretrained model weights -- large binaries, fetched by setup instead of committed
*.onnx
*.pt

# per-machine config (holds this install's camera IP etc.); config.example.json IS committed
config.json

# ffmpeg binaries dropped in for packaging
ffmpeg/

# PyInstaller build output
build/
dist/
*.manifest

# runtime / env noise
server.log
*.log
__pycache__/
*.pyc
.DS_Store
venv/
